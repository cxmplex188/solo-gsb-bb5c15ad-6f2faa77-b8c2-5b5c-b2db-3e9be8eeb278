# HMAC signing key for capability tokens. CHANGE THIS in production.
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
CAPABILITY_SECRET=dev-insecure-secret-change-me-0123456789

# Optional shared key required by POST /tokens/issue (header X-Issuer-Key).
# Leave empty to leave issuance unauthenticated (useful for local experiments).
CAPABILITY_ISSUER_KEY=

# Shared key required by the admin endpoints POST /tokens/revoke-subject and
# GET /tokens/revocations (header X-Admin-Key). When empty those endpoints
# are disabled and answer 503 (fail closed).
CAPABILITY_ADMIN_KEY=dev-insecure-admin-key-change-me-0123456789

# Storage locations (inside the container these are mounted volumes).
CAPABILITY_DB_PATH=/data/capabilities.db
CAPABILITY_FILES_DIR=/app/files

# Token lifetimes in seconds.
CAPABILITY_DEFAULT_TTL=300
CAPABILITY_MAX_TTL=3600
